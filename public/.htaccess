<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|gif|webp)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Python CGI execution
AddHandler cgi-script .py
Options +ExecCGI

RewriteEngine On

# Home page is the new gallery app. The old one-page site lives on at
# /legacy/ (302, not 301, so browsers don't cache it while things settle).
# Target is built from the request URL so it works at astro.app/ and at
# localhost/astro/public/ alike.
RewriteCond %{REQUEST_URI} ^(.*/)(index\.php)?$
RewriteRule ^(index\.php)?$ %1slideshow/ [R=302,L]

# /vis/all -> full DSO visibility report (Alignment Stars, Planets & Moon,
# Visibility Dates included). Plain /vis defaults to the DSO table only.
RewriteRule ^vis/all/?$ vis/index.php?all=1 [L,QSA]

# /lightbox/<fragment>[/<type>] -> image lightbox for that DSO, e.g.
# /lightbox/andro, /lightbox/m31/wall. Real files (api.php, img.php) pass through.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^lightbox/([^/]+)(?:/(fav|full|wall|4k))?/?$ lightbox/index.php?q=$1&type=$2 [L,QSA]
